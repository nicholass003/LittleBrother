{
    "name": "nicholass003/littlebrother",
    "description": "A LittleBrother plugin for PocketMine-MP.",
    "type": "project",
    "require": {
        "pocketmine/pocketmine-mp": "^5.0.0",
        "bstats/pocketmine-mp": "^1.0.0",
        "paroxity/commando": "dev-master",
        "nicholass003/axiom": "~1.0.2"
    },
    "require-dev": {
        "sof3/pharynx": "^0.3.6"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Paroxity/Commando"
        },
        {
            "type": "vcs",
            "url": "https://github.com/nicholass003/Axiom"
        }
    ],
    "authors": [
        {
            "name": "nicholass003",
            "email": "thisnicholass003@gmail.com"
        }
    ],
    "autoload": {
        "classmap": ["src"]
    },
    "scripts": {
        "build": "php -dphar.readonly=0 vendor/bin/pharynx -i=. -c -p=LittleBrother.phar"
    }
}
